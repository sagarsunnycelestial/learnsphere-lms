{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "client/dist/**",
      "server/dist/**",
      "logs/**",
      "project-screenshots/**"
    ]
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/"
      }
    }
  },
  "permissions": [
    { "action": "edit", "resource": "client/src/generated/**", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "npm run migration:*", "effect": "ask" }
  ]
}
